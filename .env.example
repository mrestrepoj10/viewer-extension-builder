# Copy to .env.local. The README explains every key.
# Client ID of your APS app (aps.autodesk.com).
APS_CLIENT_ID=
# Client secret of the same APS app.
APS_CLIENT_SECRET=
# Base64 Model Derivative URN of a model Autodesk has already translated, with or without the urn: prefix.
APS_MODEL_URN=
# Vercel AI Gateway key, held by the /api/agent/gateway proxy route and never sent to the browser. Only the model in lib/agent-model.ts (openai/gpt-6.1-sol) is allowed through.
AI_GATEWAY_API_KEY=
# Gallery only (the builder works without them). Postgres connection string; run pnpm db:migrate once.
DATABASE_URL=
# Read-write token of a public Vercel Blob store for published files and thumbnails.
BLOB_READ_WRITE_TOKEN=
