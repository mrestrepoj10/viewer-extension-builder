// Turns the docs index, the reference extensions and SKILL.md into TypeScript
// modules so the client bundle carries them as strings.
//
//   node lib/extension-library/scripts/build-workspace-files.mts
//
// Re-run after editing anything under extensions/, docs/ or SKILL.md.

import { execFileSync } from 'node:child_process'
import { mkdir, readdir, readFile, writeFile } from 'node:fs/promises'
import { join, relative, sep } from 'node:path'

const LIBRARY = join(import.meta.dirname, '..')
const REPO = join(LIBRARY, '..', '..')
const OUT_DIR = join(LIBRARY, 'generated')
const HEADER =
  '// Generated by lib/extension-library/scripts/build-workspace-files.mts. Do not edit.\n\n'

async function walk(dir: string): Promise<string[]> {
  const entries = await readdir(dir, { withFileTypes: true })
  const files: string[] = []
  for (const entry of entries) {
    const path = join(dir, entry.name)
    if (entry.isDirectory()) files.push(...(await walk(path)))
    else if (entry.isFile()) files.push(path)
  }
  return files
}

async function collect(dir: string, mount: string): Promise<[string, string][]> {
  const files = await walk(dir)
  const rows = await Promise.all(
    files.map(
      async (file): Promise<[string, string]> => [
        `${mount}/${relative(dir, file).split(sep).join('/')}`,
        await readFile(file, 'utf8'),
      ],
    ),
  )
  return rows.sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
}

// `${` in a plain string literal trips lint/suspicious/noTemplateCurlyInString.
function literal(text: string): string {
  return JSON.stringify(text).replace(/\$\{/g, '\\u0024{')
}

function recordModule(name: string, rows: readonly [string, string][]): string {
  const body = rows.map(([path, text]) => `  ${literal(path)}: ${literal(text)},`)
  return `${HEADER}export const ${name}: Readonly<Record<string, string>> = {\n${body.join('\n')}\n}\n`
}

async function buildWorkspaceFiles(): Promise<void> {
  const docs = await collect(join(LIBRARY, 'docs'), '/docs')
  const extensions = await collect(join(LIBRARY, 'extensions'), '/model/extensions')
  const skill = await readFile(join(LIBRARY, 'SKILL.md'), 'utf8')

  await mkdir(OUT_DIR, { recursive: true })
  const outputs: [string, string][] = [
    ['docs-files.ts', recordModule('DOCS_FILES', docs)],
    ['extension-files.ts', recordModule('EXTENSION_FILES', extensions)],
    ['skill.ts', `${HEADER}export const SKILL_INSTRUCTIONS = ${literal(skill)}\n`],
  ]
  for (const [name, text] of outputs) await writeFile(join(OUT_DIR, name), text)
  execFileSync(
    join(REPO, 'node_modules', '.bin', 'biome'),
    ['format', '--write', ...outputs.map(([name]) => join(OUT_DIR, name))],
    { cwd: REPO, stdio: 'ignore' },
  )
  const bytes = docs.reduce((sum, [, text]) => sum + Buffer.byteLength(text), 0)
  console.log(
    `generated: ${docs.length} docs files (${(bytes / 1024).toFixed(0)} KB), ${extensions.length} extension files, SKILL ${Buffer.byteLength(skill)} bytes`,
  )
}

await buildWorkspaceFiles()
